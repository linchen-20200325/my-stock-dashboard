# Secrets - NEVER commit
.streamlit/secrets.toml

# Notebook (contains hardcoded API keys)
*.ipynb
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
*.pyo
.env

# Temp / cache
temp/
*.pkl
*.cache
*.csv
*.xlsx

# Runtime state (generated at runtime, must not be committed)
macro_state.json

# Test coverage
.coverage
htmlcov/
coverage.xml

# Tooling cache (v19.181 detox: on-disk 存在但未 ignore → 防誤 commit)
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Debug protocol artifacts (cleaned up at end of session)
*.bak
debug.log

# Runtime data cache (regenerated at runtime; keep dir via .gitkeep)
data_cache/*.parquet
# v19.181: 下列頂層 parquet 為「刻意 force-track」的凍結校準快照(scripts/calibrate_* / analyze_* 讀取),
#          非 runtime cache;明示 negation 以解「規則忽略卻被追蹤」的矛盾。
!data_cache/finmind_inst.parquet
!data_cache/finmind_m1m2.parquet
!data_cache/finmind_margin.parquet
!data_cache/twii_ohlcv.parquet
data_cache/metadata.json

# Local push helper scripts (contain local paths / account names — never commit)
*.vbs
data_cache/*_snapshots/
